# daimon 部署用环境变量示例（复制为 daimon.env 后按需填写；切勿提交明文密钥）
# systemd: 放到 /etc/daimon/daimon.env
# docker-compose: 已在 compose 中透传同名变量

# HTTP 鉴权令牌（设置后 /chat 与 /run 需带 Authorization: Bearer <token>）
DAEMON_API_TOKEN=

# 各免费模型 provider 密钥（逗号分隔可多个，额度耗尽自动轮转；不填则用默认 pollinations 零密钥）
AGNES_API_KEYS=
ZHIPU_API_KEYS=
SILICONFLOW_API_KEYS=
OPENROUTER_API_KEYS=
GROQ_API_KEYS=
GEMINI_API_KEYS=
QIANFAN_API_KEYS=
DASHSCOPE_API_KEYS=
